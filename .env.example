# ============================================================
# .env.example — 环境变量模板
# 用法：复制成 .env 再填真实值
#   Windows : copy .env.example .env
#   Git Bash: cp .env.example .env
#
# ⚠️ .env 已被 .gitignore 忽略，永远不要提交真实密钥。
#    .env.example 本身要提交，且只能放占位符。
# ============================================================

# ---- 大模型 API ----
# 注意：密钥一旦提交到 git，即使后续删除，历史里依然可被翻出，必须立即去平台吊销重发
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# 国内可选（二选一，按需启用）
# DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DASHSCOPE_API_KEY=sk-your-key-here

# ---- 本地模型（Ollama）----
# 用本地模型时不产生 API 费用，适合调试
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# ---- Agent 运行参数 ----
# 调小可在调试时省 token；temperature=0 让输出可复现，便于写测试
AGENT_MODEL=gpt-4o-mini
AGENT_TEMPERATURE=0
AGENT_MAX_TOKENS=2048
# 递归/工具调用上限：不设上限可能导致 Agent 死循环烧钱
AGENT_MAX_ITERATIONS=10
LOG_LEVEL=INFO

# ---- 可观测性（LangSmith / Langfuse 等，可选）----
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-key-here
# LANGCHAIN_PROJECT=dsh-python-agent

# ---- 向量库 / 数据目录 ----
VECTOR_STORE_DIR=./data/vectorstore
