# ============================================================
# .gitignore — dsh-python-agent
# 原则：能由代码/原始数据重建的东西，一律不入库。
# ============================================================

# ===== 密钥与配置（最重要！务必最先写）=====
.env
.env.*
# 保留示例文件，方便别人照着填
!.env.example
*.key
*.pem
secrets.toml
.streamlit/secrets.toml
config/secrets.yml
credentials.json
service-account.json
*token*.json

# ===== 模型权重与缓存（体积巨大，绝不入库）=====
.cache/
models/
*.gguf
*.bin
*.safetensors
*.pt
*.pth
*.onnx
*.ckpt
.huggingface/
transformers_cache/
torch_cache/
ollama/models/

# ===== 向量库 / 索引（可由原始数据重建）=====
chroma/
chroma_db/
vectorstore/
vector_store/
data/vectorstore/
*.faiss
*.index
*.pkl
*.sqlite
*.sqlite3
*.db
qdrant_storage/
milvus/
weaviate_data/

# ===== 运行产物与日志 =====
logs/
*.log
traces/
# MLflow / 实验记录
runs/
outputs/
artifacts/
checkpoints/
sessions/
session_*.json
conversations/

# ===== 数据与数据集（关键例外，见下）=====
# 默认忽略所有对话/轨迹 jsonl，避免把调试垃圾提交上去
*.jsonl
# ⚠️ 但评测集、知识库、测试夹具是项目资产，必须入库，故显式取反。
#    取反规则必须写在忽略规则之后，否则不生效。
!data/**/*.jsonl
!data/**/*.csv
!tests/fixtures/**/*.jsonl
# 大体积原始数据不入库（用脚本或 DVC 拉取），只留说明
data/raw/
!data/raw/.gitkeep
data/**/*.parquet

# ===== Python 运行环境 =====
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/
.python-version

# ===== Python 现代工具链（uv / ruff / mypy / coverage）=====
# 注意：uv.lock 不忽略！锁文件必须提交，否则队友装到的版本和你不同
.ruff_cache/
.mypy_cache/
.pytype/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# ===== Agent 应用框架运行时 =====
.chainlit/
.gradio/
.streamlit/
.langchain/
.langgraph/
.llama_index/
crewai_db/
.autogen/

# ===== 前端 / Node（Agent 应用界面）=====
node_modules/
.next/
dist/
build/

# ===== 工具与 IDE =====
.cursor/
.idea/
.vscode/
.DS_Store
Thumbs.db
*~
*.swp
